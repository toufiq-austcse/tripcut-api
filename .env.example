# Copy to .env for a local run. The same keys go in the Modal secret "tripcut-api".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tripcut-media
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
WEB_ORIGINS=http://localhost:5173

# SAN-48 tripcut CLI (local only, not read by the API)
ANTHROPIC_API_KEY=
TRIPCUT_DIRECTOR=haiku
TRIPCUT_MODEL=claude-haiku-5-5
TRIPCUT_MUSIC=library
TRIPCUT_CLIP_VOLUME=0.25
TRIPCUT_MUSIC_VOLUME=1.0
