          },
          "min_clips": {
            "type": "integer",
            "title": "Min Clips"
          },
          "max_clips": {
            "type": "integer",
            "title": "Max Clips"
          },
          "max_trip_bytes": {
            "type": "integer",
            "title": "Max Trip Bytes"
          },
          "part_size_bytes": {
            "type": "integer",
            "title": "Part Size Bytes"
          },
          "max_parts_per_sign": {
            "type": "integer",
            "title": "Max Parts Per Sign"
